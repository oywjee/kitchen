.page {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx 48rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
  text-align: center;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input {
  padding: 22rpx 24rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.btn {
  margin-top: 16rpx;
  width: 100%;
}

.link {
  margin-top: 32rpx;
  text-align: center;
  color: #576b95;
  font-size: 28rpx;
}

.link-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #888;
}

.link-btn {
  padding: 22rpx 24rpx;
  border-radius: 12rpx;
  background: #eef8f1;
  border: 1rpx solid rgba(7, 193, 96, 0.35);
  box-sizing: border-box;
}

.link-btn--outline {
  background: #fafafa;
  border-color: #e0e0e0;
}

.link-btn--pressed {
  background: #d8ecdf !important;
  border-color: rgba(7, 193, 96, 0.45) !important;
}

.link-btn--outline.link-btn--pressed {
  background: #e8e8e8 !important;
  border-color: #d0d0d0 !important;
}

.email {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
  word-break: break-all;
}

.btn-bind {
  margin-bottom: 24rpx;
}

.tip {
  margin-top: 32rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
}

.user-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 56rpx 32rpx 48rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  line-height: 160rpx;
  margin: 0 auto 24rpx;
  background: #ededed;
  border-radius: 50%;
  font-size: 72rpx;
}

.uname {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 40rpx;
}

.btn-out {
  width: 60%;
}
