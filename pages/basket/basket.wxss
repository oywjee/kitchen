.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.hint {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
  line-height: 1.5;
}

.empty {
  padding: 120rpx 32rpx;
  text-align: center;
  color: #888;
  font-size: 28rpx;
  line-height: 1.6;
}

.card {
  padding: 24rpx 28rpx 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.row-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.name {
  font-size: 30rpx;
  color: #111;
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.count {
  font-size: 28rpx;
  color: #07c160;
  font-weight: 600;
  flex-shrink: 0;
}

.sources {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  word-break: break-all;
}
