<view class="page">
  <nav-bar />
  <view wx:if="{{!tableMenu.length}}" class="empty">餐桌还没有菜品，去「菜单」里点几道吧</view>
  <scroll-view wx:else class="list" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:for="{{tableMenu}}" wx:key="index" class="row">
      <view class="row-main">
        <view class="name-row">
          <text class="name {{item.delisted ? 'name--delisted' : ''}}">{{item.name}}</text>
          <text wx:if="{{item.delisted}}" class="tag-delisted">已下架</text>
        </view>
        <text class="sub">{{item.category}}</text>
      </view>
      <button class="btn-cancel" size="mini" type="default" data-index="{{index}}" bindtap="onRemove">取消</button>
    </view>
  </scroll-view>
  <view class="footer safe-bottom">
    <button class="btn-refresh" type="primary" bindtap="onRefreshTable">刷新餐桌</button>
    <button class="btn-clear" type="warn" disabled="{{!tableMenu.length}}" bindtap="onClearAll">清空餐桌</button>
  </view>
</view>
