<view class="page">
  <nav-bar show-back="{{true}}" back-label="返回登录" />
  <view class="card">
    <view class="title">忘记密码</view>
    <view class="desc">输入用户名与账号已绑定的邮箱进行校验。小程序端暂不自动发邮件重置，验证通过后请联系管理员或使用后续邮件找回能力。</view>
    <view class="field">
      <text class="label">用户名</text>
      <input class="input" placeholder="注册时的用户名" value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view class="field">
      <text class="label">绑定邮箱</text>
      <input class="input" type="text" placeholder="注册时填写的邮箱" value="{{email}}" bindinput="onEmailInput" />
    </view>
    <button class="btn" type="primary" bindtap="onVerify">验证信息</button>
  </view>
</view>
