.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  box-sizing: border-box;
}

.scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  padding: 16rpx 0 200rpx;
  box-sizing: border-box;
}

.sec-title {
  padding: 16rpx 32rpx 8rpx;
  font-size: 24rpx;
  color: #888;
}

.row {
  margin: 0 24rpx 12rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.row-text {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 30rpx;
  color: #111;
  display: block;
}

.dish-ing {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
  display: block;
  word-break: break-all;
}

.btn-del {
  flex-shrink: 0;
}

.empty {
  text-align: center;
  color: #888;
  padding: 80rpx 32rpx;
}

.bottom-spacer {
  height: 32rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #f7f7f7;
  border-top: 1rpx solid #e5e5e5;
  z-index: 10;
}

.btn-primary {
  width: 100%;
}

.sheet-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  pointer-events: auto;
}

.sheet-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.sheet-inner {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.picker-val {
  padding: 20rpx 24rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.input {
  padding: 20rpx 24rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.btn-confirm {
  margin-top: 16rpx;
  width: 100%;
}
