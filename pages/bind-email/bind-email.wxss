.page {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx 48rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input {
  padding: 22rpx 24rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.btn {
  margin-top: 16rpx;
  width: 100%;
}
